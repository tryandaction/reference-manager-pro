{
  "name": "reference-manager-pro",
  "displayName": "Reference Manager Pro",
  "description": "Smart Fix, quality validation, and change history for BibTeX in VS Code",
  "version": "0.3.2",
  "publisher": "EI",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "keywords": [
    "latex",
    "bibtex",
    "bibliography",
    "reference",
    "citation",
    "ai",
    "validation",
    "history",
    "formatting",
    "academic",
    "research",
    "paper",
    "thesis",
    "dissertation",
    "claude",
    "anthropic"
  ],

  "activationEvents": [
    "onLanguage:latex",
    "onLanguage:bibtex",
    "onCommand:referenceManager.smartFix",
    "onCommand:referenceManager.smartFixAll",
    "onCommand:referenceManager.validateEntries",
    "onCommand:referenceManager.showHistory",
    "onCommand:referenceManager.formatEntry",
    "onCommand:referenceManager.formatEntryLocal",
    "onCommand:referenceManager.formatAllEntries",
    "onCommand:referenceManager.formatAllEntriesLocal",
    "onCommand:referenceManager.findUnusedCitations",
    "onCommand:referenceManager.removeDuplicates",
    "onCommand:referenceManager.activateLicense",
    "onCommand:referenceManager.viewLicenseStatus",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "submenus": [
      {
        "id": "referenceManager.advancedMenu",
        "label": "Reference Manager ▸ Advanced"
      }
    ],
    "commands": [
      {
        "command": "referenceManager.smartFix",
        "title": "Smart Fix",
        "category": "Reference Manager"
      },
      {
        "command": "referenceManager.smartFixAll",
        "title": "Batch Official Fix (Smart Fix All)",
        "category": "Reference Manager"
      },
      {
        "command": "referenceManager.validateEntries",
        "title": "Validate References",
        "category": "Reference Manager"
      },
      {
        "command": "referenceManager.showHistory",
        "title": "History",
        "category": "Reference Manager"
      },
      {
        "command": "referenceManager.formatEntry",
        "title": "Advanced: Format Entry (AI)",
        "category": "Reference Manager"
      },
      {
        "command": "referenceManager.findUnusedCitations",
        "title": "Advanced: Find Unused Citations",
        "category": "Reference Manager"
      },
      {
        "command": "referenceManager.removeDuplicates",
        "title": "Advanced: Remove Duplicate Entries",
        "category": "Reference Manager"
      },
      {
        "command": "referenceManager.activateLicense",
        "title": "Activate License",
        "category": "Reference Manager"
      },
      {
        "command": "referenceManager.viewLicenseStatus",
        "title": "View License Status",
        "category": "Reference Manager"
      },
      {
        "command": "referenceManager.formatEntryLocal",
        "title": "Advanced: Format Entry (Local)",
        "category": "Reference Manager"
      },
      {
        "command": "referenceManager.formatAllEntries",
        "title": "Advanced: Format All Entries (Pro)",
        "category": "Reference Manager"
      },
      {
        "command": "referenceManager.formatAllEntriesLocal",
        "title": "Advanced: Format All Entries (Local)",
        "category": "Reference Manager"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "referenceManager.smartFix",
          "when": "editorLangId == bibtex",
          "group": "referenceManager@1"
        },
        {
          "command": "referenceManager.validateEntries",
          "when": "editorLangId == bibtex",
          "group": "referenceManager@2"
        },
        {
          "command": "referenceManager.showHistory",
          "when": "editorLangId == bibtex",
          "group": "referenceManager@3"
        },
        {
          "submenu": "referenceManager.advancedMenu",
          "when": "editorLangId == bibtex",
          "group": "referenceManager@4"
        }
      ],
      "referenceManager.advancedMenu": [
        {
          "command": "referenceManager.smartFixAll"
        },
        {
          "command": "referenceManager.removeDuplicates"
        },
        {
          "command": "referenceManager.findUnusedCitations"
        },
        {
          "command": "referenceManager.formatEntryLocal"
        },
        {
          "command": "referenceManager.formatEntry"
        },
        {
          "command": "referenceManager.formatAllEntriesLocal"
        },
        {
          "command": "referenceManager.formatAllEntries"
        }
      ]
    },
    "keybindings": [
      {
        "command": "referenceManager.smartFix",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "editorLangId == bibtex"
      }
    ],
    "configuration": {
      "title": "Reference Manager Pro",
      "properties": {
        "referenceManager.aiProvider": {
          "type": "string",
          "default": "groq",
          "enum": ["anthropic", "groq"],
          "enumDescriptions": [
            "Anthropic Claude (需要付费 API Key)",
            "Groq (免费，速度快)"
          ],
          "description": "选择 AI 提供商"
        },
        "referenceManager.apiKey": {
          "type": "string",
          "default": "",
          "description": "Anthropic API key (仅当选择 Anthropic 时需要)",
          "scope": "application"
        },
        "referenceManager.groqApiKey": {
          "type": "string",
          "default": "",
          "description": "Groq API key (从 console.groq.com 获取，免费)",
          "scope": "application"
        },
        "referenceManager.maxRetries": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum API retry attempts on failure"
        },
        "referenceManager.timeout": {
          "type": "number",
          "default": 30000,
          "minimum": 5000,
          "maximum": 120000,
          "description": "API request timeout in milliseconds"
        },
        "referenceManager.model": {
          "type": "string",
          "default": "claude-sonnet-4-20250514",
          "description": "Claude model (仅当选择 Anthropic 时使用)"
        },
        "referenceManager.groqModel": {
          "type": "string",
          "default": "llama-3.3-70b-versatile",
          "enum": ["llama-3.3-70b-versatile", "llama-3.1-8b-instant", "mixtral-8x7b-32768", "gemma2-9b-it"],
          "enumDescriptions": [
            "Llama 3.3 70B - 最强大，推荐使用",
            "Llama 3.1 8B - 更快速",
            "Mixtral 8x7B - 平衡性能",
            "Gemma 2 9B - Google 模型"
          ],
          "description": "Groq 模型选择"
        },
        "referenceManager.licenseKey": {
          "type": "string",
          "default": "",
          "description": "Your License Key for Pro features (purchase from Gumroad)",
          "scope": "application"
        },
        "referenceManager.localFormat.normalizeAuthors": {
          "type": "boolean",
          "default": true,
          "description": "Local formatter: normalize author names to \"Last, First\" when possible"
        },
        "referenceManager.localFormat.protectTitleWords": {
          "type": "array",
          "default": ["LaTeX", "BibTeX", "arXiv", "GitHub", "OpenAI", "GPU", "CPU", "AI", "DOI"],
          "items": { "type": "string" },
          "description": "Local formatter: wrap these words in {} in title to preserve capitalization"
        },
        "referenceManager.localFormat.journalAbbreviations": {
          "type": "object",
          "default": {
            "Physical Review Letters": "Phys. Rev. Lett.",
            "Nature Communications": "Nat. Commun."
          },
          "description": "Local formatter: mapping of journal/conference full name -> abbreviation"
        },
        "referenceManager.validation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable reference validation"
        },
        "referenceManager.validation.strictness": {
          "type": "string",
          "default": "normal",
          "enum": ["loose", "normal", "strict"],
          "description": "Validation strictness"
        },
        "referenceManager.officialMetadata.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable official metadata lookup by DOI"
        },
        "referenceManager.officialMetadata.timeout": {
          "type": "number",
          "default": 8000,
          "minimum": 1000,
          "maximum": 30000,
          "description": "Official metadata lookup timeout (ms)"
        },
        "referenceManager.officialMetadata.keyPolicy": {
          "type": "string",
          "default": "officialAlways",
          "enum": ["preserve", "officialWhenUnused", "officialAlways"],
          "enumDescriptions": [
            "Always keep original cite key",
            "Use official key only when the original key is not used in .tex",
            "Always replace with official key (recommended)"
          ],
          "description": "Cite key policy when official metadata is available"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "node ./scripts/esbuild.js",
    "bundle:watch": "node ./scripts/esbuild.js --watch",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "test:integration": "npm run compile && node ./out/test/integration/runTest.js",
    "test:watch": "vitest",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.28",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.25.9",
    "eslint": "^8.54.0",
    "fast-check": "^4.5.3",
    "mocha": "^10.8.2",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "undici": "^5.28.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tryandaction/reference-manager-pro"
  },
  "bugs": {
    "url": "https://github.com/tryandaction/reference-manager-pro/issues"
  },
  "homepage": "https://github.com/tryandaction/reference-manager-pro",
  "license": "MIT"
}
