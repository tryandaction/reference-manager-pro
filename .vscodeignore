# 打包时排除的文件
# 这个文件告诉vsce哪些文件不需要包含在.vsix包中

# 源代码（只需要编译后的out目录）
src/**
**/*.ts
# 编译产物（仅保留打包后的入口）
out/**
!out/extension.js

# 开发配置文件
.vscode/**
.vscode-test/**
tsconfig.json
.eslintrc.json

# Git相关
.git/**
.gitignore

# Node模块 - 已通过 esbuild 打包进 out/extension.js
node_modules/**

# 测试文件
**/test/**
**/*.test.js

# 构建脚本
scripts/**

# 私密文件（绝对不要打包！）
.env
.env.*
*.env
secrets/**
*.secret
*.key
PRODUCT_AND_BUSINESS_GUIDE.md

# Kiro/Claude 配置
.kiro/**
.claude/**

# 其他
*.map
.DS_Store
*.vsix
